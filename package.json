{
  "name": "precioreal-peru",
  "version": "1.0.0",
  "description": "Rastreador diario de precios históricos y detector de ofertas reales en tiendas de Perú (estilo SteamDB / Compy)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "scrape": "node scraper/run-daily.js",
    "scrape:quick": "node scraper/run-daily.js --quick",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "peru",
    "price-tracker",
    "descuentos",
    "ofertas",
    "historial-precios",
    "steamdb",
    "compy"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  }
}
